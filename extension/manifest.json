{
  "manifest_version": 3,
  "name": "Scam Link Shield",
  "version": "0.3.0",
  "description": "Checks links against a community-verified scam list, locally and privately.",
  "permissions": ["webNavigation", "storage", "alarms", "tabs", "contextMenus", "notifications"],
  "host_permissions": ["http://localhost:8080/*", "http://*/*", "https://*/*"],
  "action": { "default_title": "Scam Link Shield", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" }
}